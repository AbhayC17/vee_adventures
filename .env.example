# Copy to .env.local for local work, or add the same name in Vercel's
# Environment Variables settings. Never commit a real key.
GROQ_API_KEY=your-groq-key-goes-here

# Optional: a dedicated safety model for the "Discover anything" check
# (see api/moderate.ts). Leave empty to use the main model.
# GROQ_GUARD_MODEL=

# Optional: extra websites (comma separated) allowed to call /api/groq.
# Leave empty to allow only your own site.
# ALLOWED_ORIGINS=https://example.com
